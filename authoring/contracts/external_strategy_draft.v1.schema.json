{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external_strategy_draft/v1",
  "title": "External Strategy Draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "intent_summary",
    "assumptions",
    "unresolved_questions",
    "needs_capability",
    "selection_plan",
    "strategy_plan",
    "dsl_code",
    "projection_requests",
    "data_dependencies",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": "external_strategy_draft/v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_summary": {
      "type": "string"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "material"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "material": {"type": "boolean"}
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "blocks_validation"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "blocks_validation": {"type": "boolean"}
        }
      }
    },
    "needs_capability": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "reason"],
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "selection_plan": {
      "$ref": "#/$defs/selectionPlan"
    },
    "strategy_plan": {
      "$ref": "#/$defs/strategyPlan"
    },
    "dsl_code": {
      "type": "string"
    },
    "projection_requests": {
      "type": "array",
      "items": {"type": ["string", "object"]}
    },
    "data_dependencies": {
      "type": "array",
      "items": {"type": ["string", "object"]}
    },
    "rationale": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "selectionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of_policy",
        "lookback",
        "universe",
        "filters",
        "rankings",
        "candidate_output",
        "evidence_required"
      ],
      "properties": {
        "as_of_policy": {
          "enum": ["point_in_time"]
        },
        "lookback": {"type": "object"},
        "universe": {"type": "object"},
        "filters": {
          "type": "array",
          "items": {"type": "object"}
        },
        "rankings": {
          "type": "array",
          "items": {"type": "object"}
        },
        "candidate_output": {"type": "object"},
        "evidence_required": {
          "type": "array",
          "items": {"type": ["string", "object"]}
        }
      }
    },
    "strategyPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeframe",
        "inputs",
        "entry",
        "exit",
        "risk",
        "state",
        "context_dependencies"
      ],
      "properties": {
        "timeframe": {
          "type": "string",
          "pattern": "^[0-9]+(?:m|h|d|w|M)$"
        },
        "inputs": {"type": "object"},
        "entry": {
          "type": "array",
          "items": {"type": ["string", "object"]}
        },
        "exit": {
          "type": "array",
          "items": {"type": ["string", "object"]}
        },
        "risk": {
          "type": "array",
          "items": {"type": ["string", "object"]}
        },
        "state": {
          "type": "array",
          "items": {"type": ["string", "object"]}
        },
        "context_dependencies": {
          "type": "array",
          "items": {"type": ["string", "object"]}
        }
      }
    }
  }
}
