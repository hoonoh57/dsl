{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis2_point_in_time_snapshot/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "as_of",
    "knowledge_cutoff",
    "universe_id",
    "feature_version",
    "source_refs",
    "rows"
  ],
  "properties": {
    "schema_version": {"const": "axis2_point_in_time_snapshot/v1"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "pattern": "^[0-9]{14}$"},
    "knowledge_cutoff": {"type": "string", "pattern": "^[0-9]{14}$"},
    "universe_id": {"type": "string", "minLength": 1},
    "feature_version": {"type": "string", "minLength": 1},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "rows": {
      "type": "array",
      "items": {"$ref": "#/$defs/row"}
    },
    "snapshot_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "observed_as_of", "knowledge_cutoff", "formula_version"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "observed_as_of": {"type": "string", "pattern": "^[0-9]{14}$"},
        "knowledge_cutoff": {"type": "string", "pattern": "^[0-9]{14}$"},
        "formula_version": {"type": "string", "minLength": 1}
      }
    },
    "ranking": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["ranking_method", "eligible_count", "rank", "percentile", "peer_group_id"],
      "properties": {
        "ranking_method": {"type": "string", "minLength": 1},
        "eligible_count": {"type": "integer", "minimum": 1},
        "rank": {"type": "integer", "minimum": 1},
        "percentile": {"type": "number", "minimum": 0, "maximum": 100},
        "peer_group_id": {"type": "string", "minLength": 1}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "feature_id", "value_type", "value", "validity", "provenance"],
      "properties": {
        "symbol": {"type": "string", "minLength": 1},
        "feature_id": {"type": "string", "minLength": 1},
        "value_type": {"enum": ["NUMBER", "BOOLEAN", "STRING"]},
        "value": {},
        "validity": {"enum": ["VALID", "MISSING", "INVALID"]},
        "provenance": {"$ref": "#/$defs/provenance"},
        "ranking": {"$ref": "#/$defs/ranking"}
      }
    }
  }
}
