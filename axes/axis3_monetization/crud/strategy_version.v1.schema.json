{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis3_strategy_version/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "strategy_id", "version", "name", "timeframe", "dsl_code",
    "settings", "condition_refs", "parent_version", "created_at", "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "axis3_strategy_version/v1"},
    "strategy_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "minLength": 1},
    "timeframe": {"type": "string", "minLength": 1},
    "dsl_code": {"type": "string", "minLength": 1},
    "settings": {"type": "object"},
    "condition_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition_id", "version"],
        "properties": {
          "condition_id": {"type": "string", "minLength": 1},
          "version": {"type": "integer", "minimum": 1}
        }
      }
    },
    "parent_version": {"type": ["integer", "null"], "minimum": 1},
    "created_at": {"type": "string", "pattern": "^[0-9]{14}$"},
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
