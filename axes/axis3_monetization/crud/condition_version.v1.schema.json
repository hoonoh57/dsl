{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis3_condition_version/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "condition_id", "version", "name", "selection_spec",
    "parent_version", "created_at", "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "axis3_condition_version/v1"},
    "condition_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "minLength": 1},
    "selection_spec": {
      "type": "object",
      "required": ["schema_version", "selection_hash"],
      "properties": {
        "schema_version": {"const": "axis2_selection_spec/v1"},
        "selection_hash": {"type": "string", "minLength": 1}
      }
    },
    "parent_version": {"type": ["integer", "null"], "minimum": 1},
    "created_at": {"type": "string", "pattern": "^[0-9]{14}$"},
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
